# Variables del runtime de Edge Functions.
# Este archivo contiene marcadores sintéticos; sustitúyelos sólo en un entorno
# aislado y nunca los expongas mediante variables VITE_*.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=not-a-real-secret

# Las siguientes variables aparecen en mensajes del cliente para la función
# de IA, pero lanzo-ai-agent no está versionada en este repositorio. No son
# necesarias para authorize-image-upload y no habilitan por sí mismas la IA.
# AI_API_KEY=not-a-real-secret
# OPENAI_API_KEY=not-a-real-secret
