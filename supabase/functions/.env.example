# Variables del runtime de Edge Functions.
# Este archivo contiene marcadores sintéticos; sustitúyelos sólo en un entorno
# aislado y nunca los expongas mediante variables VITE_*.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=not-a-real-secret

# Secretos y configuración de `lanzo-ai-agent`. Se leen únicamente dentro de
# Edge Functions; nunca los expongas mediante variables VITE_*.
AI_API_KEY=not-a-real-secret
# Compatibilidad heredada: sólo se usa cuando AI_API_KEY no está definida.
OPENAI_API_KEY=not-a-real-secret
# URL HTTP completa del endpoint, no una URL base ambigua.
AI_API_URL=https://provider.example/v1/responses
AI_MODEL=replace-with-supported-model

# `usage` requiere solamente SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY.
# El análisis requiere además AI_API_URL, AI_MODEL y AI_API_KEY (o el fallback
# OPENAI_API_KEY). Todos los valores anteriores son marcadores sintéticos.
