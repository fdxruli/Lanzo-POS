# Lanzo-POS: valores sintéticos para un entorno local aislado.
# Nunca copies aquí claves de producción ni una service_role.

# -----------------------------------------------------------------------------
# Variables públicas del cliente Vite
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=not-a-real-local-publishable-key
VITE_ADMIN_APP_ORIGIN=http://127.0.0.1:4173
VITE_PUBLIC_STORE_ORIGIN=http://127.0.0.1:4174

# Integraciones opcionales y configuración visible en el cliente.
VITE_SUPPORT_EMAIL=optional
VITE_GOOGLE_CLIENT_ID=optional
VITE_AI_EDGE_FUNCTION=optional
VITE_AI_PROVIDER=edge
VITE_ENABLE_LICENSE_REALTIME=false
VITE_ENABLE_CLOUD_SALE_CANCELLATIONS=true
VITE_ENABLE_CLOUD_CASHIER_SALES=false
VITE_ENABLE_CLOUD_LAYAWAYS=false
VITE_CLOUD_REQUEST_DEBUG=false

# Se incorpora al bundle del navegador; no es un secreto criptográfico.
VITE_LICENSE_SALT=not-a-secret-client-build-salt

# Metadatos de build. vite.config.js define valores para los dos primeros
# cuando no se proporcionan; no deben contener secretos.
VITE_APP_VERSION=0.0.0
VITE_BUILD_DATE=optional
VITE_BUILD_COMMIT=local

# -----------------------------------------------------------------------------
# Variables públicas del runtime serverless de la tienda
# -----------------------------------------------------------------------------
# Lista separada por comas de orígenes permitidos. Es una allowlist pública,
# no una credencial. El valor local evita usar dominios oficiales.
PUBLIC_STORE_ORIGINS=http://127.0.0.1:4174

# SUPABASE_SERVICE_ROLE_KEY, AI_API_KEY, OPENAI_API_KEY y VERCEL_TOKEN no
# pertenecen al frontend ni a este archivo. Los secretos de Edge Functions
# tienen un ejemplo separado en supabase/functions/.env.example.
