[
  {
    "schema_name": "private",
    "relname": "restaurant_cloud_contract_state",
    "columns": [
      {
        "name": "singleton",
        "type": "boolean",
        "default": "true",
        "not_null": true
      },
      {
        "name": "contract_version",
        "type": "integer",
        "default": "1",
        "not_null": true
      },
      {
        "name": "writes_paused",
        "type": "boolean",
        "default": "false",
        "not_null": true
      },
      {
        "name": "generation",
        "type": "bigint",
        "default": "1",
        "not_null": true
      }
    ],
    "constraints": [
      {
        "name": "restaurant_cloud_contract_state_contract_version_check",
        "type": "c",
        "definition": "CHECK ((contract_version = ANY (ARRAY[1, 2])))"
      },
      {
        "name": "restaurant_cloud_contract_state_generation_check",
        "type": "c",
        "definition": "CHECK ((generation > 0))"
      },
      {
        "name": "restaurant_cloud_contract_state_pkey",
        "type": "p",
        "definition": "PRIMARY KEY (singleton)"
      },
      {
        "name": "restaurant_cloud_contract_state_singleton_check",
        "type": "c",
        "definition": "CHECK (singleton)"
      }
    ]
  },
