ssedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/components/caja/sections/__tests__/CajaStaffAuditPanel.progressiveDisclosure.test.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/components/caja/sections/__tests__/CajaStatusCard.progressiveDisclosure.test.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/components/caja/sections/__tests__/FinancialDiagnosticsPanel.test.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/components/caja/sections/index.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/components/common/AbonoModal.jsx","messages":[{"ruleId":"no-unused-vars","severity":1,"message":"'React' is defined but never used.","line":2,"column":8,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":13,"suggestions":[{"messageId":"removeVar","data":{"varName":"React"},"fix":{"range":[47,53],"text":""},"desc":"Remove unused variable 'React'."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// src/components/common/AbonoModal.jsx\nimport React, { useCallback, useState, useEffect } from 'react';\nimport { useDismissibleHistoryLayer } from '../../hooks/useDismissibleHistoryLayer';\nimport './AbonoModal.css';\n\nexport default function AbonoModal({ show, onClose, onConfirmAbono, customer }) {\n  const [monto, setMonto] = useState('');\n  const [error, setError] = useState('');\n\n  const [sendReceipt, setSendReceipt] = useState(true);\n\n  const deudaActual = customer?.debt || 0;\n\n  const handleClose = useCallback(() => {\n    onClose();\n  }, [onClose]);\n\n  const dismissModal = useDismissibleHistoryLayer({\n    isOpen: Boolean(show && customer),\n    onDismiss: handleClose,\n    layerId: 'legacy-abono-modal'\n  });\n\n  useEffect(() => {\n    if (!show) {\n      setMonto('');\n      setError('');\n    }\n  }, [show]);\n\n  const handleMontoChange = (e) => {\n    const value = e.target.value;\n    setError('');\n    if (parseFloat(value) > deudaActual) {\n      setError('El abono no puede ser mayor que la deuda actual.');\n    }\n    setMonto(value);\n  };\n\n  const handleSaldarCuenta = () => {\n    setMonto(deudaActual.toFixed(2));\n    setError('');\n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault();\n    const montoAbono = parseFloat(monto);\n\n    if (isNaN(montoAbono) || montoAbono <= 0) {\n      setError('Ingresa un monto válido.');\n      return;\n    }\n    if (montoAbono > deudaActual) {\n      setError('El abono no puede ser mayor que la deuda actual.');\n      return;\n    }\n\n    onConfirmAbono(customer, montoAbono, sendReceipt);\n  };\n\n  if (!show || !customer) return null;\n\n  return (\n    <div className=\"modal\" style={{ display: 'flex', zIndex: 'var(--z-modal-mid)' }}>\n      <div className=\"modal-content abono-modal\">\n        <h2 className=\"modal-title\">Abonar a Deuda</h2>\n        <div className=\"abono-summary\">\n          <p>Cliente: <strong>{customer.name}</strong></p>\n          <p className=\"deuda-label\">Deuda Actual:</p>\n          <p className=\"deuda-total\">${deudaActual.toFixed(2)}</p>\n        </div>\n\n        <form onSubmit={handleSubmit}>\n          <div className=\"form-group\">\n            <label className=\"form-label\" htmlFor=\"abono-monto\">Monto a Abonar ($):</label>\n            <input\n              className={`form-input ${error ? 'invalid' : ''}`}\n              id=\"abono-monto\"\n              type=\"number\"\n              step=\"0.01\"\n              min=\"0\"\n              max={deudaActual.toFixed(2)}\n              value={monto}\n              onChange={handleMontoChange}\n              required\n              autoFocus\n            />\n            {error && <p className=\"form-help-text validation-message error\">{error}</p>}\n          </div>\n\n          <button\n            type=\"button\"\n            className=\"btn btn-secondary\"\n            onClick={handleSaldarCuenta}\n          >\n            Saldar Cuenta (${deudaActual.toFixed(2)})\n          </button>\n\n          <div className=\"form-group-checkbox\">\n            <input\n              id=\"send-receipt-abono\"\n              type=\"checkbox\"\n              checked={sendReceipt}\n              onChange={(e) => setSendReceipt(e.target.checked)}\n            />\n            <label htmlFor=\"send-receipt-abono\">Enviar recibo por WhatsApp</label>\n          </div>\n\n          <button type=\"submit\" className=\"btn btn-save\" disabled={!!error || !monto}>\n            Confirmar Abono\n          </button>\n          <button type=\"button\" className=\"btn btn-cancel\" onClick={dismissModal}>\n            Cancelar\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/components/common/AdminAuthModals.test.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/components/common/AdminEnrollmentModal.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warn