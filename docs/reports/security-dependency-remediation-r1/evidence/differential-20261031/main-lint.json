ppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/utils/moneyMath.js","messages":[{"ruleId":"no-unused-vars","severity":1,"message":"'e' is defined but never used.","line":16,"column":14,"nodeType":"Identifier","messageId":"unusedVar","endLine":16,"endColumn":15}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// src/utils/moneyMath.js\r\nimport Big from 'big.js';\r\n\r\n// Configurar estándar contable: Redondeo de mitad a par (Banker's Rounding)\r\n// Evita el sesgo estadístico de siempre redondear hacia arriba en el .5\r\nBig.RM = Big.roundHalfEven;\r\n\r\nexport const Money = {\r\n  /**\r\n   * Inicializa un valor seguro. Retorna una instancia de Big.\r\n   */\r\n  init: (value) => {\r\n    if (value === null || value === undefined || value === '') return new Big(0);\r\n    try {\r\n      return new Big(value);\r\n    } catch (e) {\r\n      throw new Error(`[MoneyMath] Invalid financial value: ${value}`);\r\n    }\r\n  },\r\n\r\n  add: (a, b) => Money.init(a).plus(Money.init(b)),\r\n  \r\n  subtract: (a, b) => Money.init(a).minus(Money.init(b)),\r\n  \r\n  // Alias retrocompatibles: parte del código aún usa la API corta.\r\n  sub: (a, b) => Money.subtract(a, b),\r\n  \r\n  multiply: (a, b) => Money.init(a).times(Money.init(b)),\r\n  \r\n  // Alias retrocompatible para evitar fallos en flujos de venta existentes.\r\n  mul: (a, b) => Money.multiply(a, b),\r\n  \r\n  divide: (a, b) => {\r\n    const divisor = Money.init(b);\r\n    if (divisor.eq(0)) throw new Error('Division by zero');\r\n    return Money.init(a).div(divisor);\r\n  },\r\n\r\n  /**\r\n   * Solo debe usarse al momento de PERSISTIR en la BD o MOSTRAR en UI.\r\n   * Internamente todo debe fluir como instancias Big o strings crudos.\r\n   */\r\n  toCents: (value) => parseInt(Money.init(value).times(100).round(0).toString(), 10),\r\n  \r\n  fromCents: (cents) => Money.init(cents).div(100),\r\n\r\n  /**\r\n   * Retorna el número redondeado a 2 decimales exactos como Number,\r\n   * útil solo para la compatibilidad con componentes UI tontos.\r\n   */\r\n  toNumber: (value) => Number(Money.init(value).round(2).toString()),\r\n\r\n  /**\r\n   * Retorna el string exacto. Úsalo para guardar en Dexie si decides no usar centavos.\r\n   */\r\n  toExactString: (value) => Money.init(value).toString()\r\n};\r\n","usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/utils/nlpEngine.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/utils/notFoundBarcode.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/utils/noticePolicy.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/utils/parseAgentResponse.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/utils/pausedWhatsappContact.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/SECURITY_DIFF_MAIN_1A0D/src/utils/pausedWhatsappContact.test.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecated